# Modelo de variáveis do RedStore Discord Bridge.
# Em produção, configure estes valores na SquareCloud; não envie um .env real ao GitHub.

ENVIRONMENT=production

# Discord Developer Portal
DISCORD_CLIENT_ID=preencha-com-o-client-id
DISCORD_CLIENT_SECRET=preencha-com-o-client-secret
DISCORD_BOT_TOKEN=preencha-com-o-token-do-bot
DISCORD_GUILD_ID=preencha-com-o-id-do-servidor
# ID do administrador que receberá as notificações de depósitos pendentes por DM.
DEPOSIT_NOTIFICATION_DISCORD_ID=preencha-com-o-id-do-admin
# Opcional: use o mesmo ID durante os testes; deixe vazio para comandos globais.
DISCORD_COMMAND_GUILD_ID=

# OAuth2 > Redirects no Discord Developer Portal
OAUTH_REDIRECT_URI=https://redstore-discord-bridge.squareweb.app/auth/discord/callback

# Frontend publicado na Vercel
SITE_URL=https://seu-projeto.vercel.app
CORS_ORIGINS=https://seu-projeto.vercel.app

# API Java publicada na SquareCloud
REDSTORE_API_URL=https://redstoreback.squareweb.app

# Gere chaves aleatórias com pelo menos 32 caracteres.
# REDSTORE_BRIDGE_API_KEY deve ser igual a DISCORD_BRIDGE_API_KEY na API Java.
REDSTORE_BRIDGE_API_KEY=gere-uma-chave-segura-com-32-ou-mais-caracteres
INTERNAL_API_KEY=gere-outra-chave-segura-com-32-ou-mais-caracteres
SESSION_SECRET=gere-um-segredo-aleatorio-com-32-ou-mais-caracteres

DATABASE_PATH=/tmp/redstore.db
COOKIE_SECURE=true
REQUIRE_GUILD_MEMBERSHIP=false
LOG_LEVEL=INFO

# Sistema de tickets do Discord
TICKET_ENABLED=true
# Categoria onde os canais de ticket serão criados
TICKET_CATEGORY_ID=0
# IDs dos cargos que podem atender tickets, separados por vírgula
TICKET_SUPPORT_ROLE_IDS=
# Cargo com permissão máxima para fechar qualquer ticket
TICKET_MASTER_ROLE_ID=0
# Canal que receberá os logs de tickets fechados
TICKET_LOG_CHANNEL_ID=0
TICKET_CLOSE_DELAY_SECONDS=10

# Comandos !prova e /prova
# Se ficar 0, o bot procura um cargo chamado exatamente "Entregador".
DELIVERER_ROLE_ID=1536139607530541056
DELIVERER_ROLE_NAME=Entregador
# ID do canal onde as provas serão publicadas. Se ficar 0, usa o canal do comando.
PROOF_CHANNEL_ID=1536141398821179412

# Cargos do ranking de depósitos confirmados.
DEPOSIT_BRONZE_ROLE_ID=1540196431875276820
DEPOSIT_PRATA_ROLE_ID=1540196669801635910
DEPOSIT_OURO_ROLE_ID=1540196877193060372
# Intervalo da reconciliação automática, em segundos.
DEPOSIT_ROLE_SYNC_INTERVAL_SECONDS=300

# Cargos do ranking de depósitos confirmados.
DEPOSIT_BRONZE_ROLE_ID=1540196431875276820
DEPOSIT_PRATA_ROLE_ID=1540196669801635910
DEPOSIT_OURO_ROLE_ID=1540196877193060372
# Intervalo da reconciliação automática, em segundos.
DEPOSIT_ROLE_SYNC_INTERVAL_SECONDS=300
